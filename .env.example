# 复制成 .env.local 后填入真实值，用于本地 `vercel dev` 调试。
# 部署到 Vercel 时请在 Settings → Environment Variables 里配置同样的变量。

# —— 必填 ——

# 细粒度 Personal Access Token，权限：Contents → Read and write
# 创建地址：https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# 管理后台密码（不填则退回默认值 admin123，强烈建议设置）
ADMIN_PASSWORD=

# —— 可选 ——

# 存放数据的仓库，格式 owner/repo。
# 不填时会自动使用 Vercel 注入的 VERCEL_GIT_REPO_OWNER / VERCEL_GIT_REPO_SLUG，
# 也就是当前站点所在的仓库。
GITHUB_REPO=

# 数据文件所在分支。建议留空：留空时会自动使用仓库的默认分支，
# 这样即便在预览（Preview）地址上发布文章，内容也会落到正式分支上。
GITHUB_BRANCH=

# 数据文件路径，默认 data/blog-db.json
GITHUB_DATA_PATH=

# 登录令牌的签名密钥。不填则复用 ADMIN_PASSWORD。
# 修改它会让所有已登录的会话立即失效。
AUTH_SECRET=

# —— AI 写作助手（可选）——
# 任何 OpenAI 兼容接口都能接（OneAPI、DeepSeek、通义、智谱、Kimi、OpenRouter、Ollama…）。
# 三个都填了才会启用后台的「生成正文 / 生成标题 / 一键排版」。

# 接口根地址。填到 /v1 即可，会自动拼上 /chat/completions；
# 也可以直接填完整的 .../chat/completions。
AI_BASE_URL=

# 模型服务商的密钥。只存在服务端，浏览器拿不到。
AI_API_KEY=

# 模型名，必须填你的网关支持的名称
AI_MODEL=

# 可选：单次回复的最大 token 数。留空时按操作取默认值（正文 4000 / 标题 400 / 排版 8000）
AI_MAX_TOKENS=

# 可选：请求超时毫秒数，默认 55000（Vercel 上该函数最多跑 60 秒）
AI_TIMEOUT_MS=
